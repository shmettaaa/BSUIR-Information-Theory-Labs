<Controls:MetroWindow xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
        x:Class="InformationTheoryLab1.ColumnarMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationTheoryLab1"
        mc:Ignorable="d"
        Title="ColumnarMethodWindow" Height="441" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBox x:Name="MainTextBox" HorizontalAlignment="Left" Margin="281,140,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="333" RenderTransformOrigin="0.432,0.508" FontFamily="Segoe UI Variable Display Semibold" FontSize="20" IsEnabled="False"/>
        <TextBox x:Name="KeyTextBox" HorizontalAlignment="Left" Margin="281,192,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="333" FontFamily="Segoe UI Variable Display Semibold" FontSize="20" IsEnabled="False"/>
        <Label x:Name="TextLabel" Content="Введите исходный текст:" HorizontalAlignment="Left" Margin="31,140,0,0" 
               VerticalAlignment="Top" Width="250" FontSize="20"/>
        <Label x:Name="KeyLabel" Content="Введите ключевое слово:" HorizontalAlignment="Left" Margin="31,192,0,0" 
               VerticalAlignment="Top" Width="250" FontSize="20"/>
        <Label Content="Столбцовый метод шифрования" HorizontalContentAlignment="Center" 
               HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="502" 
               Height="53" FontSize="25"/>
        <Label Content="(c одним ключевым словом, текст на русском языке)" HorizontalContentAlignment ="Center"
               HorizontalAlignment="Center" Margin="0,45,0,0" VerticalAlignment="Top" Width="382" FontSize="15"/>
        <RadioButton x:Name="EncryptRadioButton" Content="Шифровать" HorizontalAlignment="Left"
                     Margin="191,86,0,0" VerticalAlignment="Top" Height="39" FontSize="20" Checked="RadioButton_Checked"/>
        <RadioButton x:Name="DecryptRadioButton" Content="Дешифровать" HorizontalAlignment="Right"
                     Margin="0,86,191,0" VerticalAlignment="Top" FontSize="20" Height="39" Checked="RadioButton_Checked"/>

        <Button x:Name="OpenFileButton" Content="📂 Открыть файл" HorizontalAlignment="Center" 
                Margin="0,310,0,0" VerticalAlignment="Top" Width="150" Height="30" 
                Click="OpenFileButton_Click"/>

        <Button x:Name="ResultButton" Content="Шифровать" HorizontalAlignment="Center" Margin="0,253,0,0"
                VerticalAlignment="Top" Width="192" Height="47" FontWeight="Bold" IsEnabled="False" Click="ResultButton_Click"/>

        <TextBlock x:Name="ResultTextBlock" HorizontalAlignment="Left" Margin="137,346,0,0"
                   TextWrapping="Wrap" VerticalAlignment="Top"
                   Width="185" Height="31" FontSize="20"/>

    </Grid>
</Controls:MetroWindow>