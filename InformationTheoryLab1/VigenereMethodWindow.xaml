<Controls:MetroWindow xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro" 
        x:Class="InformationTheoryLab1.VigenereMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InformationTheoryLab1"
        mc:Ignorable="d"
        Title="Метод Вижинера" Height="500" Width="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <TextBox x:Name="MainTextBox" 
         HorizontalAlignment="Left" 
         Margin="281,125,0,0"  
         TextWrapping="Wrap" 
         VerticalAlignment="Top" 
         Width="333" 
         Height="62"
         MaxHeight="62"
         FontSize="20" 
         IsEnabled="False" 
         TextChanged="TextBox_TextChanged" 
         VerticalScrollBarVisibility="Auto"/>
        <TextBox x:Name="KeyTextBox" HorizontalAlignment="Left" Margin="281,192,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="333" FontSize="20" IsEnabled="False" TextChanged="TextBox_TextChanged"/>

        <Border BorderBrush="Black" BorderThickness="1" HorizontalAlignment="Left" 
                Margin="281,244,0,0" VerticalAlignment="Top" Width="333" Height="30"
                Background="#FFF5F5F5">
            <TextBlock x:Name="GeneratedKeyTextBlock" Text="" 
                       Margin="5" FontSize="16" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </Border>

        <Label x:Name="TextLabel" Content="Введите исходный текст:" HorizontalAlignment="Left" Margin="31,140,0,0" 
               VerticalAlignment="Top" Width="250" FontSize="20"/>
        <Label x:Name="KeyLabel" Content="Введите ключ:" HorizontalAlignment="Left" Margin="31,192,0,0" 
               VerticalAlignment="Top" Width="250" FontSize="20"/>
        <Label x:Name="GeneratedKeyLabel" Content="Сгенерированный ключ:" HorizontalAlignment="Left" Margin="31,244,0,0" 
               VerticalAlignment="Top" Width="250" FontSize="20" Foreground="Blue"/>

        <Label Content="Метод Вижинера" HorizontalContentAlignment="Center" 
               HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="502" 
               Height="53" FontSize="25" FontWeight="Bold"/>
        <Label Content="(самогенерирубщийся ключ, текст на русском языке)" HorizontalContentAlignment ="Center"
               HorizontalAlignment="Center" Margin="0,45,0,0" VerticalAlignment="Top" Width="500" FontSize="15" Foreground="Gray"/>

        <RadioButton x:Name="EncryptRadioButton" Content="Шифровать" HorizontalAlignment="Left"
                     Margin="191,86,0,0" VerticalAlignment="Top" Height="39" FontSize="20" Checked="RadioButton_Checked"/>
        <RadioButton x:Name="DecryptRadioButton" Content="Дешифровать" HorizontalAlignment="Right"
                     Margin="0,86,191,0" VerticalAlignment="Top" FontSize="20" Height="39" Checked="RadioButton_Checked"/>

        <Button x:Name="OpenFileButton" Content="📂 Открыть файл" HorizontalAlignment="Left" 
                Margin="16,22,0,0" VerticalAlignment="Top" Width="140" Height="30" 
                Click="OpenFileButton_Click"/>

        <Button x:Name="ResultButton" Content="Шифровать" HorizontalAlignment="Center" Margin="0,286,0,0"
                VerticalAlignment="Top" Width="192" Height="47" FontWeight="Bold" IsEnabled="False" Click="ResultButton_Click"/>

        <Border BorderBrush="Black" BorderThickness="1" 
        HorizontalAlignment="Left" Margin="31,391,0,0"
        VerticalAlignment="Top" Width="630" Height="83"
        Background="#FFF0F0F0">
            <TextBlock x:Name="ResultTextBlock" TextWrapping="Wrap"
               Margin="5,0,5,0" FontSize="20" VerticalAlignment="Center" Height="78"/>
        </Border>
        <Button x:Name="SaveFileButton" Content="💾 Сохранить" 
        HorizontalAlignment="Center" Margin="0,344,0,0"
        VerticalAlignment="Top" Width="120" Height="29"
        Click="SaveFileButton_Click"/>
    </Grid>
</Controls:MetroWindow>